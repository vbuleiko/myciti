# Copy to .env (repo root or server/) and adjust. All values are optional.

# --- HTTP server ---
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# allowed CORS origins for the API ("*" or a comma-separated list)
CORS_ORIGIN=*

# --- Source site ---
MYCITI_BASE_URL=https://www.myciti.org.za
# Please keep a descriptive User-Agent with a link to the project
USER_AGENT=myciti-live-map/0.1 (+https://github.com/vbuleiko/myciti; unofficial, polls each route page at most once a minute)
# product token matched against robots.txt groups
ROBOTS_AGENT=myciti-live-map
TIMEZONE=Africa/Johannesburg

# Routes to poll, comma-separated (empty = all routes from the network map)
ROUTES=

# --- Polling (be gentle with the site) ---
# routes with buses being tracked: seconds between polls of one route page (minimum 60)
POLL_LIVE_SEC=60
# routes with scheduled service but no live tracking today
POLL_UNTRACKED_SEC=180
# max seconds between checks of a route with no service right now
POLL_IDLE_MAX_SEC=3600
# start polling a route this many seconds before its next departure
POLL_LEAD_SEC=600
# parallel requests to the site (max 2)
MAX_CONCURRENCY=2
# minimum gap between two request starts, ms
MIN_REQUEST_GAP_MS=1000
# hard ceiling on requests to the site per rolling minute (max 60)
MAX_REQUESTS_PER_MIN=45
# when the site's average response time exceeds this, poll proportionally less often...
SLOW_ORIGIN_MS=15000
# ...up to this multiple of the normal interval
SLOW_ORIGIN_MAX_FACTOR=3
# abandon pages larger than this (MB, decoded); the biggest route page is ~9 MB
MAX_BODY_MB=48
REQUEST_TIMEOUT_MS=45000
# exponential backoff for a failing route page
BACKOFF_BASE_SEC=30
BACKOFF_MAX_SEC=1800
# static network (routes, stops, traces) refresh
NETWORK_REFRESH_HOURS=24
# cache directory (network + last snapshot of each route)
DATA_DIR=./data

# --- History (observation log) ---
# append every change of a published stop time to a daily JSON Lines file, so actual passing
# times can be analysed later (the site itself keeps no history); roughly 5-30 MB per day,
# compressed after the day is over
OBSERVATIONS=true
# where the day files go (default: DATA_DIR/observations)
OBSERVATIONS_DIR=
# delete day files older than this many days (0 = keep forever)
OBSERVATIONS_KEEP_DAYS=0

# --- Position engine ---
SUSPECT_THRESHOLD_MIN=30
PRE_DEPARTURE_MIN=5
POST_ARRIVAL_MIN=1
TERMINAL_MERGE_MAX_GAP_MIN=10
# hide buses whose snapshot is older than this (minutes, 0 = never): a forecast from stale data is fiction
MAX_DATA_AGE_MIN=20

# --- API limits ---
# concurrent /api/stream connections accepted (nginx additionally allows 6 per client address)
MAX_SSE_CLIENTS=200
# believe X-Forwarded-* headers; only behind a reverse proxy you control (docker-compose sets it)
TRUST_PROXY=false
