{
  "name": "myciti-live-map",
  "private": true,
  "type": "module",
  "description": "Unofficial live map of MyCiTi (Cape Town) buses, estimated from published stop passing times",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @myciti/server --filter @myciti/web run dev",
    "build": "pnpm -r run build",
    "start": "pnpm --filter @myciti/server run start",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "verify": "pnpm --filter @myciti/server run verify",
    "observations": "pnpm --filter @myciti/server run observations"
  }
}
